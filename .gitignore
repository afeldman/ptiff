##############################################
# Goose (local agent configuration)
##############################################

.goose

# docs/ is versioned for its committed Markdown/design files, but the
# Doxygen build output (build/docs/) stays ignored. Only the hand-written
# Doxygen sources under docs/doxygen/ are additionally tracked.
docs/*
!docs/.gitkeep
!docs/doxygen/
!docs/doxygen/**

# Generated Doxygen output
build/docs/

