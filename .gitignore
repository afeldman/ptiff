##############################################

examples/data/

##############################################
# Downloaded sample data (scripts/fetch_sample_tiff.sh)
##############################################

scripts/samples/*
# Exception: the frozen C++-oracle-produced interop fixture that
# crates/ptiff-c/tests/oracle_fields.rs cross-validates against (R4/Phase 12
# precursor). The C++ generator (gen_interop_fixture.cpp) that produced it was
# deleted along with libptiff, so this file is now irreplaceable and must be
# tracked for CI to have it at all.
!scripts/samples/ptiff_interop_fixture.tif

