root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# CMake sources and @ONLY/pkg-config templates use a 4-space indent.
[*.{cmake,in}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.{rb,ruby}]
indent_size = 2

# Octave/Scilab (bindings + benchmarks) use a 2-space indent.
[*.m]
indent_size = 2

# The hand-written Octave MEX adapter C++ (.oct source) follows the same
# 2-space style as the surrounding Octave binding `.m` wrappers.
[bindings/octave/mex/*.cpp]
indent_size = 2

# SWIG interface files (bindings/swig/*.i) conventionally use a 2-space
# indent for the `%typemap { ... }` bodies and comments.
[*.i]
indent_size = 2

# Sphinx reStructuredText directives align at 3 spaces.
[*.{rst,rst.in}]
indent_size = 3

# Ruby metadata files (gemspec/Gemfile/Rakefile) follow the 2-space Ruby style.
[Gemfile]
indent_size = 2

[Rakefile]
indent_size = 2

[*.gemspec]
indent_size = 2

# Nix expressions (flake.nix / default.nix) conventionally use a 2-space indent.
[*.nix]
indent_size = 2

# Generated CMake install scripts (.cmake.in templates) follow a 2-space layout.
[*.cmake.in]
indent_size = 2

# Generated dependency lockfiles (Cargo.lock / uv.lock) are machine-generated
# and keep whatever indentation the tool emits; skip indent checks on them.
[Cargo.lock]
indent_size = unset

[uv.lock]
indent_size = unset
