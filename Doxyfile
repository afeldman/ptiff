# ============================================================================
# PTIFF -- Doxygen configuration
# ----------------------------------------------------------------------------
# Generates HTML + XML documentation for the libptiff public API and the
# project-wide Markdown sources. See docs/doxygen/ for the hand-written pages.
#
# Generate interactively with:
#     doxygen Doxyfile
#
# Or as part of the CMake build (find_package(Doxygen) + doxygen_add_docs):
#     cmake --build build --target docs
#
# Requires: doxygen >= 1.9  (developed/tested against 1.17.0)
# ============================================================================

# ----------------------------------------------------------------------------
# Project information
# ----------------------------------------------------------------------------
PROJECT_NAME           = "PTIFF"
PROJECT_NUMBER         = 0.4.0
PROJECT_BRIEF          = "Planetary Terrain-sensor Image File Format -- reference implementation"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = build/docs

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

# ----------------------------------------------------------------------------
# Input
# ----------------------------------------------------------------------------
INPUT                  = README.md \
                         ARCHITECTURE.md \
                         docs/doxygen \
                         libptiff/include \
                         libptiff/README.md

INPUT_ENCODING         = UTF-8

# Recursion on (headers live under libptiff/include/ptiff/...)
RECURSIVE              = YES

# File patterns to scan for documentation
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.hxx \
                         *.md \
                         *.dox

# Explicitly exclude generated/config-internal trees
EXCLUDE                = libptiff/include/ptiff/core/version.hpp.in
EXCLUDE_PATTERNS      =
EXCLUDE_SYMBOLS        = detail \
                         ptiff::detail

EXAMPLE_PATH           =
EXAMPLE_PATTERNS       =
EXAMPLE_RECURSIVE      = NO
IMAGE_PATH             =
INPUT_FILTER           =
FILTER_PATTERNS        =
FILTER_SOURCE_FILES    = NO
FILTER_SOURCE_PATTERNS =

# ----------------------------------------------------------------------------
# Source browsing
# ----------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
USE_HTAGS              = NO

VERBATIM_HEADERS       = YES

# ----------------------------------------------------------------------------
# Extraction / documentation scope
# ----------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
HIDE_SCOPE_NAMES       = NO
HIDE_COMPOUND_REFERENCE= NO

INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHORT_NAMES            = NO
HIDE_UNDOC_RELATIONS   = NONE

# ----------------------------------------------------------------------------
# Preprocessing (common for PTIFF headers)
# ----------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
EXPAND_AS_DEFINED      =
SKIP_FUNCTION_MACROS   = YES

# PTIFF uses generate_export_header(); make the export macro a no-op for
# parsing so class/function declarations are seen.
PREDEFINED             = PTIFF_EXPORT= \
                         PTIFF_API= \
                         "DOXYGEN_SHOULD_SKIP_THIS=1" \
                         "__attribute__(x)="

EXPAND_AS_DEFINED      = PTIFF_EXPORT \
                         PTIFF_API

# ----------------------------------------------------------------------------
# Diagrams
# ----------------------------------------------------------------------------
HAVE_DOT               = NO
UML_LOOK               = NO
DOT_PATH               =
DOTFILE_DIRS           =
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS          = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = png
INTERACTIVE_SVG        = NO
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
LAYOUT_FILE            =
DOT_CLEANUP            = YES

# ----------------------------------------------------------------------------
# Index / structure
# ----------------------------------------------------------------------------
ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          =
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
ENABLED_SECTIONS       =
MAX_INITIALIZER_LINES  = 30
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
FILE_VERSION_FILTER    =
LAYOUT_FILE            =
CITE_BIB_FILES         =

# ----------------------------------------------------------------------------
# Output: HTML + XML (XML future-proofs tooling / CI API diffs)
# ----------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT             = html
HTML_FILE_EXTENSION     = .html
HTML_HEADER             =
HTML_FOOTER             =
HTML_STYLESHEET         =
HTML_EXTRA_STYLESHEET   =
HTML_EXTRA_FILES        =
HTML_COLORSTYLE_HUE     = 220
HTML_COLORSTYLE_SAT     = 100
HTML_COLORSTYLE_GAMMA   = 80
HTML_DYNAMIC_SECTIONS   = NO
HTML_INDEX_NUM_ENTRIES  = 100
GENERATE_DOCSET        = NO
DOCSET_FEEDNAME         = "PTIFF"
DOCSET_BUNDLE_ID        = org.ptiff.doxygen
GENERATE_HTMLHELP       = NO
GENERATE_CHI            = NO
GENERATE_QHP            = NO
GENERATE_TREEVIEW       = YES
ENUM_VALUES_PER_LINE    = 4
TREEVIEW_WIDTH          = 250
EXT_LINKS_IN_WINDOW     = NO
FORMULA_FONTSIZE        = 10
USE_MATHJAX             = NO
MATHJAX_RELPATH         =
SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO
EXTERNAL_SEARCH         = NO
SEARCHENGINE_URL        =
SEARCHDATA_FILE         = searchdata.xml
EXTERNAL_SEARCH_ID      =
EXTRA_SEARCH_MAPPINGS   =

GENERATE_LATEX          = NO
GENERATE_RTF            = NO
GENERATE_MAN            = NO
GENERATE_DOCBOOK        = NO
GENERATE_AUTOGEN_DEF    = NO
GENERATE_PERLMOD        = NO
GENERATE_XML            = YES
XML_OUTPUT              = xml
XML_PROGRAMLISTING      = YES
XML_NS_MEMB_FILE_SCOPE  = NO

# ----------------------------------------------------------------------------
# Warning behavior
# ----------------------------------------------------------------------------
QUIET                   = NO
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = NO
WARN_FORMAT             = "$file:$line: $text"
WARN_LOGFILE            =

# ----------------------------------------------------------------------------
# Markdown handling
# ----------------------------------------------------------------------------
USE_MDFILE_AS_MAINPAGE  = docs/doxygen/mainpage.md
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
MARKDOWN_ID_STYLE       = DOXYGEN

# ----------------------------------------------------------------------------
# Misc / behaviour
# ----------------------------------------------------------------------------
TAB_SIZE                = 4
ALIASES                 = "copyright=\par Copyright &copy; 2026 PTIFF contributors."
OPTIMIZE_OUTPUT_FOR_C   = NO
OPTIMIZE_OUTPUT_JAVA    = NO
OPTIMIZE_FOR_FORTRAN    = NO
OPTIMIZE_OUTPUT_VHDL    = NO
OPTIMIZE_OUTPUT_SLICE   = NO
EXTENSION_MAPPING       =

# Treat the first sentence of a C++ Doxygen comment (up to the first period) as an
# implicit @brief when no explicit @brief is given. PTIFF headers use explicit @brief;
# this is a safety-net for the ones that rely on the first-sentence convention.
JAVADOC_AUTOBRIEF        = YES
LOOKUP_CACHE_SIZE       = 0
ALLEXTERNALS            = NO
EXTERNAL_GROUPS         = YES
EXTERNAL_PAGES          = YES
